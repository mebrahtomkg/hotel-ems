{
  "name": "hotel-ems",
  "version": "1.0.0",
  "author": "Mebrahtom Kidane",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch ./src/server.ts",
    "db:reset": "NODE_ENV=development tsx ./src/resetDb.ts",
    "build": "NODE_ENV=production swc src -d dist --strip-leading-paths",
    "start": "NODE_ENV=production node ./dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix:safe": "biome lint --write ./src",
    "lint:fix:unsafe": "biome lint --write --unsafe ./src",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write ."
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.11.29",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "@biomejs/biome": "^2.2.4",
    "prettier": "^3.6.2"
  }
}
